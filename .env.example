# ==========================================================
# ServiceNow MCP Connector Configuration Example
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your actual .env file to version control!
# ==========================================================

# Your ServiceNow instance URL (e.g., https://devXXXXX.service-now.com)
SERVICENOW_INSTANCE_URL=https://devXXXXX.service-now.com

# Authentication Method: basic or oauth
SERVICENOW_AUTH_METHOD=basic

# Instance Credentials
SERVICENOW_BASIC_USERNAME=admin
SERVICENOW_BASIC_PASSWORD=your_instance_password_here

# MCP Permission Tiers
WRITE_ENABLED=true
SCRIPTING_ENABLED=true
CMDB_WRITE_ENABLED=true
ATF_ENABLED=false

# Tool Packaging (full | service_desk | platform_developer)
MCP_TOOL_PACKAGE=full
